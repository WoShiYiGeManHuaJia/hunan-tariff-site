# 复制为 .env 后填入你自己的值（.env 已被 .gitignore 排除，不会提交）
# 云端用 GitHub Actions 时无需本文件，直接在 Settings → Secrets 里填
# 四个通道可任意组合：配几个推几个，没配的自动跳过

# ── 钉钉 ──────────────────────────────────────────
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token
DINGTALK_SECRET=SEC你的加签密钥

# ── 飞书 ──────────────────────────────────────────
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/你的id
FEISHU_SECRET=你的签名密钥

# ── 企业微信机器人 ────────────────────────────────
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的key

# ── 邮件（SMTP，密码填授权码）────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的授权码
MAIL_TO=收件人1@qq.com,收件人2@163.com
# MAIL_FROM=发件人显示（默认同 SMTP_USER）
# MAIL_FROM_NAME=资费监控

# ── 通用可选项 ────────────────────────────────────
SINCE_HOURS=24
FOCUS_SEC=hunan
SITE_URL=https://woshiyigemanhuajia.github.io/hunan-tariff-site/
