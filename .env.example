# 复制本文件为 .env 后填入你自己的值（.env 不会被提交）
# 云端用 GitHub Actions 时无需本文件，直接在仓库 Settings → Secrets 里填

# ── 必填 ───────────────────────────────────────────
# 钉钉机器人 Webhook 地址
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=你的token

# 钉钉机器人加签密钥（机器人安全设置里勾选「加签」才有，SEC 开头）
# 没开加签就留空
DINGTALK_SECRET=SEC你的加签密钥

# ── 可选 ───────────────────────────────────────────
# 统计最近 N 小时的变化
SINCE_HOURS=24

# 明细只列哪个省份（拼音，如 guangdong / zhejiang / beijing）
FOCUS_SEC=hunan

# 消息末尾附带的站点链接
SITE_URL=https://woshiyigemanhuajia.github.io/hunan-tariff-site/
