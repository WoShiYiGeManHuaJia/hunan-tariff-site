        "动感地带超星卡26新版—39元档": {
          "资费标准": "39元/月",
          "方案编号": "26HN200859",
          "资费类型": "套餐",
          "归属": "个人资费",
          "适用范围": "仅限14-28周岁客户办理，且须为校园客户，办理时需登记或者验证学生身份信息，如提供学生证等相关证明。",
          "适用地区": "湖南",
          "销售渠道": "移动校园渠道",
          "上线日期": "2026年9月4日",
          "下线日期": "2050年12月31日",
          "有效期限": "业务有效期为一年，如任何一方未向对方提出终止或变更要求，自动延期一年",
          "在网要求": "无",
          "退订方式": "主套餐产品无法退订，可在线下营业厅、校园渠道进行套餐变更",
          "违约责任": "无",
          "国内通话": "200分钟",
          "国内通用流量": "70GB",
          "短信": "",
          "定向流量": "",
          "宽带": "",
          "移动高清": "",
          "权益": "",
          "超出资费说明": "语音超出后0.1元/分钟；短信超出后0.1元/条；不含中国港澳台。流量超出后按照5元/GB收费，不足1GB按照1GB收费",
          "其他服务内容": "1、办理当月套餐费按天收取，次月起一次性收取。2、套餐内国内通用流量可结转、可共享、不可转赠，结转后的流量不可共享、不可转赠。套餐内国内语音可共享、不可结转、不可转赠。以上国内资源不含中国港澳台地区。3、根据教育部和工信部共同印发的《关于提高高等学校网络管理和服务质量的通知》（教科信厅函〔2021〕33号）文件要求，基础电信企业应建立面向学校的网络资费优惠政策，故制定校园客户专属优惠，仅针对校园客户且校园专属套餐可叠加，考虑不同地区、不同学校的实际情况，各学校存在差异。",
          "其他说明": ""
        },
