        "2026-畅享裸宽带-100M-月租30元-12个月": {
          "资费标准": "30元/月",
          "方案编号": "26GX200740",
          "资费类型": "套餐",
          "归属": "政企资费",
          "适用范围": "1.广西移动集团单位实名用户 2.广西移动实名校园客户",
          "适用地区": "广西",
          "销售渠道": "线下及线上渠道",
          "上线日期": "2026年4月25日",
          "下线日期": "2045年12月31日",
          "有效期限": "有效期限12个月，有效期满后宽带停止使用。宽带到期前三个月可办理宽带续费，续费后可继续使用宽带。",
          "在网要求": "12个月",
          "退订方式": "致电10086或到当地营业厅咨询办理。",
          "违约责任": "合约期内如提前中止合约，须赔付合约款及设备款（两项之和）。合约款：合约期内未履行月份数/合约月份数*215元+合约期间获赠话费及优惠总额；设备款：140元，其中10GPON网关为180元（若归还终端无需收取），具体金额以系统的产品或设备价值界定。",
          "国内通话": "0分钟",
          "国内通用流量": "0GB",
          "定向流量": "",
          "宽带": "100M",
          "移动高清": "",
          "权益": "",
          "超出资费说明": "",
          "其他服务内容": "带宽100M，可在校园地址申请享受宽带上网业务。宽带合约到期后，归还终端设备可办理宽带销户(B模式无终端除外）。",
          "其他说明": "新装宽带：当月安装激活起至次月1日，合约未生效属于宽带体验期，可享宽带使用权、不收取宽带费用，激活后如对该号码办理停机、销户、离网、携转、变更至低于宽带业务承诺每月手机套餐标准消费的套餐等业务，可在归还设备后办理。"
        }
      },
